# Para red local use la IP fija del servidor, sin barra final.
# Ejemplo: http://192.168.1.50
PUBLIC_URL=http://192.168.1.50

# Use :80 para una IP o legalmind.colegio.edu para HTTPS automático con dominio.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_DB=legalmind
POSTGRES_USER=legalmind_app
POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CLAVE_LARGA

# Genere valores diferentes, aleatorios y de al menos 32 caracteres.
BETTER_AUTH_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_32_CARACTERES
AUDIT_HASH_SALT=CAMBIAR_POR_OTRO_SECRETO_ALEATORIO_DE_32_CARACTERES

LOCAL_AI_MODEL=llama3.1:8b
LOCAL_AI_EMBEDDING_MODEL=nomic-embed-text
LOCAL_AI_TIMEOUT_MS=120000
LOCAL_AI_EMBEDDING_TIMEOUT_MS=30000
LOCAL_AI_MAX_OUTPUT_TOKENS=900
LOCAL_AI_CONTEXT_SIZE=8192
LOCAL_AI_TEMPERATURE=0.1
LOCAL_AI_KEEP_ALIVE=15m

API_RATE_LIMIT_PER_MINUTE=180
REQUEST_TIMEOUT_MS=120000
JSON_BODY_LIMIT=1mb
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=30000
OCR_LANGUAGE=spa
OCR_PDF_SCALE=2
DOCUMENT_WORKER_INTERVAL_MS=3000
REMINDER_WORKER_INTERVAL_MS=30000
